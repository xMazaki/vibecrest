{
  "name": "vibe-crest",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe Crest, panneau flottant de supervision pour Claude Code et Codex sur Windows",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "preview": "electron scripts/preview.cjs",
    "dev": "npm run icons && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5174 && cross-env VIBE_CREST_DEV=1 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && npm run typecheck && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node test/placement.test.cjs",
    "preview:view": "electron scripts/preview-view.cjs",
    "hero": "electron scripts/make-hero.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.vibecrest.desktop",
    "productName": "Vibe Crest",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/agent-hook.cjs",
        "to": "agent-hook.cjs"
      },
      {
        "from": "electron/focus-window.ps1",
        "to": "focus-window.ps1"
      },
      {
        "from": "electron/vscode-extension",
        "to": "vscode-extension"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "VibeCrest-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "keywords": [
    "claude-code",
    "codex",
    "windows",
    "electron",
    "ai-agents",
    "developer-tools",
    "vibe-island"
  ],
  "license": "MIT",
  "author": "Mazaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMazaki/vibecrest.git"
  },
  "homepage": "https://github.com/xMazaki/vibecrest#readme",
  "bugs": {
    "url": "https://github.com/xMazaki/vibecrest/issues"
  }
}
